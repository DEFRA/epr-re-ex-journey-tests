{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>DEFRA/epr-re-ex-service//renovate-presets/default"],
  "enabledManagers": [
    "dockerfile",
    "docker-compose",
    "nvm",
    "custom.regex",
    "mise",
    "npm"
  ],
  "packageRules": [
    {
      "description": "Dependabot owns npm. Renovate takes only @playwright/test, so it can move in one PR with the Dockerfile image whose browsers must match it",
      "matchManagers": ["npm"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@playwright/test"],
      "enabled": true
    },
    {
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "playwright"
    }
  ]
}
